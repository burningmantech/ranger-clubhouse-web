<ModalDialog @title="Outstanding Item(s)" @isInline={{@isInline}} @modalId={{@modalId}} as |modal|>
  <modal.body>
    <strong class="text-danger">
      The following still needs to be dealt with before marking this person off site:
    </strong>
    <ul class="mt-2 mb-2">
      {{#each @dialog.data as |item|}}
        <li>{{item}}</li>
      {{/each}}
    </ul>
    <p>
      You may choose to ignore this warning and proceed to mark this person off site. However, you really should take
      care of the items listed above.
    </p>
  </modal.body>

  <modal.footer>
    <UiButtonRow>
      <UiButton @type="warning" @onClick={{@onConfirm}} @size="md">Mark Person As Off Site</UiButton>
      <UiButton @onClick={{@onClose}} @size="md">Deal With Items</UiButton>
    </UiButtonRow>
  </modal.footer>
</ModalDialog>
